<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR>
  <SYSTEM>
    <SHORT-NAME>{{ spec.system.name | default('autosar-system') }}</SHORT-NAME>
    <DESCRIPTION>{{ spec.system.description | default('Generated by AUTOSAR AI MDE hackathon scaffold') }}</DESCRIPTION>
  </SYSTEM>
  <ECUS>
  {% for ecu in spec.ecus %}
    <ECU>
      <SHORT-NAME>{{ ecu.name }}</SHORT-NAME>
      <PROCESSOR>{{ ecu.processor | default('unknown') }}</PROCESSOR>
      <SAFETY-CLASS>{{ ecu.asil | default('QM') }}</SAFETY-CLASS>
    </ECU>
  {% endfor %}
  </ECUS>
  <SERVICES>
  {% for service in spec.services %}
    <SERVICE>
      <SHORT-NAME>{{ service.name }}</SHORT-NAME>
      <ROUTE>{{ service.route | default('undefined') }}</ROUTE>
      <PROTOCOL>{{ service.protocol | default('SOME/IP') }}</PROTOCOL>
    </SERVICE>
  {% endfor %}
  </SERVICES>
  <SIGNALS>
  {% for signal in spec.signals %}
    <SIGNAL>
      <SHORT-NAME>{{ signal.name }}</SHORT-NAME>
      <SOURCE>{{ signal.source }}</SOURCE>
      <DESTINATION>{{ signal.destination }}</DESTINATION>
      <FORMAT>{{ signal.format | default('CAN') }}</FORMAT>
    </SIGNAL>
  {% endfor %}
  </SIGNALS>
  <SAFETY>
  {% for item in spec.safety %}
    <CHECK>{{ item }}</CHECK>
  {% endfor %}
  </SAFETY>
</AUTOSAR>

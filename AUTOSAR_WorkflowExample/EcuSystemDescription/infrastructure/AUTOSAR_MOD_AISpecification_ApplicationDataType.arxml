            <APPLICATION-PRIMITIVE-DATA-TYPE>
              <SHORT-NAME>OperModSt1</SHORT-NAME>
              <LONG-NAME>
                <L-4 L="EN">Operation Mode Status</L-4>
              </LONG-NAME>
              <DESC>
                <L-2 L="EN">State are grouped into super-states according to the following hierarchy: Super-state: Idle - State: PrepIdle - State: Idle Super-state: identification - State: PrepIdn - State: IdAprvd - State: AcsyPost Super-state: Acsy - State: Acsy - State: IgOnPost Super-state: ignition - State: IgOn - State: EngRunng Super-state: crank - State: CrkPre - State: Crk</L-2>
              </DESC>
              <CATEGORY>VALUE</CATEGORY>
              <INTRODUCTION>
                <P>
                  <L-1 L="EN">Special modes (PrepIdn, CrkPre, IgOnPost, AcsyPost, PrepIdle, ...):</L-1>
                </P>
              </INTRODUCTION>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                    <COMPU-METHOD-REF DEST="COMPU-METHOD" BASE="CompuMethods">OperModSt1</COMPU-METHOD-REF>
                    <DATA-CONSTR-REF DEST="DATA-CONSTR" BASE="DataConstrs">OperModSt1</DATA-CONSTR-REF>
                    <UNIT-REF DEST="UNIT" BASE="Units">NoUnit</UNIT-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
            </APPLICATION-PRIMITIVE-DATA-TYPE>
            <APPLICATION-PRIMITIVE-DATA-TYPE>
              <SHORT-NAME>OperModSts1</SHORT-NAME>
              <LONG-NAME>
                <L-4 L="EN">Operation Mode Status</L-4>
              </LONG-NAME>
              <DESC>
                <L-2 L="EN">State are grouped into super-states according to the following hierarchy: Super-state: Idle - State: PrepIdle - State: Idle Super-state: identification - State: PrepIdn - State: IdAprvd - State: AcsyPost Super-state: Acsy - State: Acsy - State: IgOnPost Super-state: ignition - State: IgOn - State: EngRunng Super-state: crank - State: CrkPre - State: Crk</L-2>
              </DESC>
              <CATEGORY>VALUE</CATEGORY>
              <INTRODUCTION>
                <P>
                  <L-1 L="EN">Base modes (Idle, IdAprvd, Acsy, IgOn, Crk, EngRunng):</L-1>
                  <L-1 L="EN">Special modes (PrepIdn, CrkPre, IgOnPost, AcsyPost, PrepIdle, ...):</L-1>
                </P>
                <LIST TYPE="UNNUMBER">
                  <ITEM>
                    <P>
                      <L-1 L="EN">Elements are fixed, no additional elements are possible. It must be implemented.</L-1>
                    </P>
                  </ITEM>
                </LIST>
                <LIST TYPE="UNNUMBER">
                  <ITEM>
                    <P>
                      <L-1 L="EN">Additional elements are possible. The implementation is voluntary.</L-1>
                    </P>
                  </ITEM>
                </LIST>
              </INTRODUCTION>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                    <COMPU-METHOD-REF DEST="COMPU-METHOD" BASE="CompuMethods">OperModSts1</COMPU-METHOD-REF>
                    <DATA-CONSTR-REF DEST="DATA-CONSTR" BASE="DataConstrs">OperModSts1</DATA-CONSTR-REF>
                    <UNIT-REF DEST="UNIT" BASE="Units">NoUnit</UNIT-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
            </APPLICATION-PRIMITIVE-DATA-TYPE>
            <APPLICATION-PRIMITIVE-DATA-TYPE>

            <APPLICATION-PRIMITIVE-DATA-TYPE>
              <SHORT-NAME>CluSt1</SHORT-NAME>
              <LONG-NAME>
                <L-4 L="EN">Clutch State</L-4>
              </LONG-NAME>
              <DESC>
                <L-2 L="EN">Information about the state of the clutch.</L-2>
              </DESC>
              <CATEGORY>VALUE</CATEGORY>
              <INTRODUCTION>
                <P>
                  <L-1 L="EN">There exist 4 principal states: open, intermediate, near closed, hard closed.The definition of intermediate and near closed has to be made for each project separately.
Definition of "Clutch":</L-1>
                  <L-1 L="EN">Be aware that this information is not necessarily equal with the drivetrain open information. If a torque converter clutch is open, the drivetrain can still be closed. In contrary the drivetrain is open for Manual Transmission (MT) and Automatic Manual Transmission (AMT), if the clutch is open!</L-1>
                </P>
                <LIST TYPE="UNNUMBER">
                  <ITEM>
                    <P>
                      <L-1 L="EN">for Automatic Transmission (AT), Continuously Variable Transmission (CVT) it is the converter clutch</L-1>
                    </P>
                  </ITEM>
                  <ITEM>
                    <P>
                      <L-1 L="EN">for Manual Transmission (MT), Automatic Manual Transmission (AMT) it is the clutch between the gear box and the engine drivetrain</L-1>
                    </P>
                  </ITEM>
                </LIST>
              </INTRODUCTION>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                    <COMPU-METHOD-REF DEST="COMPU-METHOD" BASE="CompuMethods">CluSt1</COMPU-METHOD-REF>
                    <DATA-CONSTR-REF DEST="DATA-CONSTR" BASE="DataConstrs">CluSt1</DATA-CONSTR-REF>
                    <UNIT-REF DEST="UNIT" BASE="Units">NoUnit</UNIT-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
            </APPLICATION-PRIMITIVE-DATA-TYPE>

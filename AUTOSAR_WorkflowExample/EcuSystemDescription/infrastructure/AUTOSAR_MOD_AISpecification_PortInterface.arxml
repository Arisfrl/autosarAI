			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PrkgLiIndcn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Parking Light Indication</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This interface represents the indication to switch on left, right, both or no parking lights. As long as parking lights are requested by Human Machine Interface (HMI) switch, the corresponding value has to be set. It's also used to provide indication to Human Machine Interface (HMI) (feedback for cluster) and other body domain functionalities whether the left parking lights, the right parking lights or the positioning lights are active. As long as this functionality is required the value has to be set to "on".</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PrkgLi</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">PrkgLiIndcn1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>

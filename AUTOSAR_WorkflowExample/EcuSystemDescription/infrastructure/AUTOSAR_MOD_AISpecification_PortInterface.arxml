			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>CrashSev1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Crash Severity</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Crash severity - calculated (after t0 = time of first contact of involved objects in crash situations) or estimated (before t0)</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Each algorithm must be able to provide the maximum '100%', even if only binary decision is possible.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Sev</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0% means no crash (default) 100% means maximum detectable crash severity (e.g. in case of binary detectable severity 100% is to give in case of detected crash)</L-2>
				  </DESC>
				  <INTRODUCTION>
					<P>
					  <L-1 L="EN">increasing crash severity results in increasing value</L-1>
					</P>
				  </INTRODUCTION>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>

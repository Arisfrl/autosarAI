			  <LONG-NAME>
				<L-4 L="EN">Latch Release Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">User request to release/unlock the latch of rear lid or tank flap or backlite window. "On" means latch release to unlock or open a lid or backlite window</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Req</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>

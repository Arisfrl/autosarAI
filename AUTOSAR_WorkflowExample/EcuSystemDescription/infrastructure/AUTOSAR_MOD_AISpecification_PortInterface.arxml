				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>LvlgReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Leveling Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request the position of a headlamp leveling actuator. 100% means most upward position (of the headlamps). 0% means most downward position (e.g. low beam adjusted maximum down to the road).101% means invalid. Initial value = Invalid</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>

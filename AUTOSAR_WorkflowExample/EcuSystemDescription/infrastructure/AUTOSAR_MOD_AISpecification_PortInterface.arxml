			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>MirrFltSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Mirror Fault Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Used as feedback from an actuator component to indicate that the mirror is broken or not. Note that no details of the fault are transmitted, but just an operational / defective fault indication. This enables a control component to decide whether a mirror is broken and should not be actuated.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">The interface is not used for detailed diagnostics.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevErrSt2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>

			  <LONG-NAME>
				<L-4 L="EN">Locking Feedback Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request special blinking for feedback that the locking system was unlocked, locked or safed by user request. The blink sequence is represented by a separate interface.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>

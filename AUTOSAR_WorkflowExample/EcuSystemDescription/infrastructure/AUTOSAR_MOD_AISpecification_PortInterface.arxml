			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BriReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brightness Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Requests the brightness of a light source or the control panel. The percentage value (independent of light actuator type and environment e.g. voltage of electrical system) depends on the functionality that the light source shall be switched on for.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">100 percent means full power of the light actuator. Invalid is chosen for emergency illumination in case of jammed network.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Req</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkActrFailrForBrkOnDmd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Actuator Failure for Brake on Demand 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Brake actuator failure status with respect to brake-on-demand functions</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkActrFailrForBrkOnDmd</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: no failure 1: failure</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevErrSt2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkActrIntvg1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Actuator Intervening 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Brake actuator is used to slow down the vehicle (either due to brake pedal being applied or external brake request, e.g. from Adaptive Cruise Control (ACC))</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkActrIntvg</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: off 1: on</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkActrMod1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Actuator Mode 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Brake actuator action or status, with regards to parking brake functionality.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkActrMod</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">BrkActrMod1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkActrOvrheatd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Actuator Overheated 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">One flag indicating that temperature of at least one actuator component is high, e.g. valves overheated. If this flag is set the actuator is in a critical condition. The external function, e.g. Roll Stability Controller can decide whether to use the brake or not.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkActrOvrheatd</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: normal brake temperature 1: brake overheated</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">TSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkActrSatn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Actuator Saturation 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Brake actuator saturation status. This is a not wheel individual but global information.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkActrSatn</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0:No saturation 1:Saturation due to actuator limitation</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">BrkActrSatn1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkAssiReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Assist Request 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Indicates that the brake system should modify its brake assist mode for hazard situations.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkAssiReq</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: no brake assist request 1: brake assist request</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">ReqSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkLiInten1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Light Intensity 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Requested intensity of brake lights.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkLiInten</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: no brake light activation 100: full intensity</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkLiOnReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Light On Request 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request to illuminate brake lights.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Electronic Stability Control (ESC) intervention does not illuminate brake lights (e.g. active booster).</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkLiOnReq</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: brake lights off 1: if brake lights are to be illuminated (driver braking or active controlled deceleration (e.g. Adaptive Cruise Control brakes slowly));</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">ReqSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkModReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Mode Request 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Indicates whether the brake request is comfort or safety related.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkReqMod</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0 : comfort relevant 1 : safety relevant</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">BrkMod1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkPedlOvrd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Pedal Override 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Information that driver overrides SW-C "Follow control and acceleration arbitration" with brake pedal as a result of brake torque arbitration</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkPedlOvrd</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: no override 1: override</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OvrdnSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkPedlPsd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Pedal Pressed 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Information that the brake pedal is pressed.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">When other brake system elements (an active booster for example) are in use, a combination of the state of the brake light switch (on) and the brake hydraulic pressure (above a threshold) do not necessarily indicate that the brake pedal is pressed.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkPedlPsd</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: not pressed 1: pressed</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">PsdNotPsd1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkPedlVal1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Pedal Value 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">position of the brake pedal physical lower limit: no pedal activation physical upper limit: full pedal stroke</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkPedlVal</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0 to 100 %</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkPrevn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Prevention 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request to avoid braking, e.g. for Adaptive Cruise Control and Vehicle Longitudinal Control. Request includes aspects from traffic point of view. Final decision remains in the actuator control.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Allowed acceleration offset has higher priority than this request.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkPrevn</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: No request 1: Inhibit brake</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">ReqSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkRdyReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Ready Request 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Indicates that the brake system has to be prepared for braking (e.g. air gap elimination)</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkRdyReq</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: no brake ready request 1: brake ready request</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">ReqSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkReqTyp1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Request Type 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Type of vehicle deceleration force requested by e.g. Stand Still Manager to Electric Parking Brake.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkReqTyp</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">BrkReqTyp1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkReqTyp2</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Request Type 2</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Type of vehicle deceleration force requested by e.g. Stand Still Manager to Electronic Stability Control</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkReqTyp</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">BrkReqTyp2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkTracCtrlIntvg1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Traction Control Intervening 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Brake traction control intervention status. True if intervening at at least one wheel.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkTracCtrlIntvg</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0 = Traction Control is off or Traction Control does not use the brakes 1 = At least one wheel has traction brake control intervening</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">CtrlSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BrkYawCtrlIntvgPerWhl1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Brake Yaw Control Intervening for Wheel</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Wheel with yaw stability brake control intervention. Wheel individual. (E.g. information for Roll Stability Control (Rsc) and Suspension (Susp))</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BrkYawCtrlIntvgPerWhl</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0 = No brake intervention from yaw control 1 = Wheel has yaw stability brake control intervening</L-2>
				  </DESC>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BtnMplSt256</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Multi State Button 256 States</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">user input to system: Information which of the 256 states of the user interface device (button, switch, knob, slider, ...) is selected</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BtnMplSt4</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Multi State Button 4 States</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">user input to system: Information which of the four states of the user interface device (button, switch, knob, slider, ...) is selected</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr7</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BtnMplSt8</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Multi State Button 8 States</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">user input to system: Information which of the eight states of the user interface device (button, switch, knob, slider, ...) is selected</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BtnSimple1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Button Simple</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">user input to system: Information if the button was pressed or not pressed.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">PsdNotPsd1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>BypSlipCtrlReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Bypass Slip Control Request 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request from Roll Stability Control (RSC) only to inhibit internal Electronic Stability Control (ESC) slip control.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">To be able to brake beyond pressure corresponding to slip control (e.g. for wheel lift detection).</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>BypSlipCtrlReqPerWhl</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0 = Slip Control shall not be bypassed 1 = Slip Control shall be bypassed</L-2>
				  </DESC>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>CarFindrReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Car Finder Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Demand to activate / deactivate car finder functionality. The request can be set e.g. manually by the user or via user settings in the Man Machine Interface (MMI).</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Req</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>CarHeiSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Car Height Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Information on the height of the vehicle</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">value greater than 100% means invalid; initial value = value greater than 100%</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>CarHeiSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Car Height Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Information on the height of the vehicle</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Sts</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">value greater than 100% means invalid; initial value = value greater than 100%</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ChdProtnCmd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Child Protection Command</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This is the functional command to the actuator component to execute activation or deactivation of child lock.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Cmd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">ChdProtnCmd1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ChdProtnSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Child Protection Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status if child protection is activated or not.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Cmd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ChdProtnSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Child Protection Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status if child protection is activated or not.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Cmd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ChimerCmd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Chimer Command</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Command to turn On/Off the chimer in the cluster. The type of the chimer sequence is up to the driver implementation in the cluster.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Cmd</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">OFF - chimer driver activation not requested ON - chimer driver activation requested.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>CluPedlRat1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Clutch Pedal Ratio</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Position of the clutch pedal</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Evaluated signal jitter free without time filtering, plausibility check, monitored, including replacement value. 0% is driver off the pedal, offsets are removed. 100% must be ensured at end point of the pedal. Shall cover the 100% as well;signal is sent with initialisation</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>CluPedlRat</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>

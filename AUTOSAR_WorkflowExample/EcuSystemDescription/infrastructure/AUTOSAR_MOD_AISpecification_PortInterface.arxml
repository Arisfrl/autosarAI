			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Maximum permitted engine speed for engine protection, must not be exceeded by shifting</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">default value after reset: max value</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>EngNMax</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">N1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>EngNMin1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Minimum Engine Speed Setpoint</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Minimum engine speed from engine control point of view.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">E.g. engine idle speed to be arbitrated by Powertrain Coordinator (PTC) with all other requested engine speeds (Air Conditioner (A/C), alternator, transmission, ...).Signal is sent with initialisation</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>EngNMin</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">N1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>

				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Max</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Maximum</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq7</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>

				<L-4 L="EN">Trailer Status 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Detection of presence of a trailer by switch type detection. Information: Trailer attached 0 means 'not present' 1 means 'present'</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrlrSts</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0 means 'not present' 1 means 'present'</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DetnSts1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmAuthent1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission Authentication</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Authentication process between transmitter and receiver</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmAuthent</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr8</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmAxleActrSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission Axle Actuator State</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">State of the Front/Rear Axle Actuator. This could be a Torque Vector Device, an active control differential or a locking differential.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmAxleActrSt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevErrSt4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmCluSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Clutch State</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">The interface informs about the current state of the clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Be aware that this information is not necessarily equal with the drivetrain open information.
If a torque converter clutch is open, the drivetrain can still be closed. In contrary the drivetrain is open for Manual Transmission (MT) and Automatic Manual Transmission (AMT), if the clutch is open!
Default value after reset is open.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmCluSt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">CluSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmCluStAct1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Actual Clutch State</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">The interface informs about the current state of the clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">There exist 4 principal states: open, intermediate, near closed, hard closed (Note: The definition of intermediate and near closed has to be made for each project separately)
Definition of "Clutch": </L-1>
				  <L-1 L="EN">Be aware that this information is not necessarily equal with the drivetrain open information. If a torque converter clutch is open, the drivetrain can still be closed. In contrary the drivetrain is open for Manual Transmission (MT) and Automatic Manual Transmission (AMT), if the clutch is open!Default value after reset is open.</L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">for Automatic Transmission (AT), Continuously Variable Transmission (CVT) it is the converter clutch </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">for Manual Transmission (MT), Automatic Manual Transmission (AMT) it is the clutch between the gear box and the engine drivetrain </L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmCluStAct</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">CluSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmCluStConsold1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Consolidated Clutch State</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">The interface informs about the current state of the clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Be aware that this information is not necessarily equal with the drivetrain open information. If a torque converter clutch is open, the drivetrain can still be closed. In contrary the drivetrain is open for Manual Transmission (MT) and Automatic Manual Transmission (AMT), if the clutch is open!Default value after reset is open.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmCluStConsold</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">CluSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmCluStTar1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Target State of the Clutch</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">The interface informs about the target state of the clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">There exist 4 principal states: open, intermediate, near closed, hard closed (Note: The definition of intermediate and near closed has to be made for each project separately)
Definition of "Clutch": </L-1>
				  <L-1 L="EN">Be aware that this information is not necessarily equal with the drivetrain open information. If a torque converter clutch is open, the drivetrain can still be closed. In contrary the drivetrain is open for Manual Transmission (MT) and Automatic Manual Transmission (AMT), if the clutch is open!Default value after reset is open.</L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">for Automatic Transmission (AT), Continuously Variable Transmission (CVT) it is the converter clutch </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">for Manual Transmission (MT), Automatic Manual Transmission (AMT) it is the clutch between the gear box and the engine drivetrain </L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmCluStTar</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">CluSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmFlgCtrsftActv1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Countershaft Active</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Indicates whether the gear is in low range mode, e.g. for sport utility vehicles (SUV) or offroad vehicles with countershaft gearboxes (high range / low range). 0: countershaft inactive (standard condition) 1: countershaft active</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmFlgCtrsftActv</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmFlgDtOpen1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Drivetrain Opened</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">indicates whether the drive train is open due to driver input. Transitional states between fully open and fully closed drivetrain shall be indicated as open in this signal. Automatic Transmission (AT): Lever in N or in P or in neutral state because if internal reasons (e.g. internal failure) Manual Transmission (MT): Estimation based on clutch pedal pressed and optional neutral gear recognition. 0 : Drivetrain fully closed 1 : Drivetrain fully open or between fully open and fully closed)</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmFlgDtOpen</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmFlgParkLockEngd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Park Lock Engaged</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status of gearbox on engaged parking lock (P-drive) of the Automatic Transmission (AT). 0 : not engaged 1 : engaged</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmFlgParkLockEngd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmFlgShiftProgs1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Gear Shift in Progress</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Flag indicates that a gear shift is in progress.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">A gear shift is in progress while the transmission is changing the gear. This typically includes the preparation of the clutches, i.e. the fast filling phase of the clutch on automatic transmissions.</L-1>
				  <L-1 L="EN">“Gear shift is active” is a synonym for “Gear shift is in progress”.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmFlgShiftProgs</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Transmission: Gear Shift in Progress</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmFlgSptMod1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Sport Mode Request by Driver</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Flag signals that the driver activated the sport mode. 0 = deactivated 1 = activated</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmFlgSptMod</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmFlgSptModReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Sport Mode Request by Driver</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Flag signals that the driver activated the sport mode. 0 = deactivated 1 = activated</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmFlgSptModReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmFlgWntrMod1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Winter Mode Request by Driver</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Flag signals that the driver activated the winter mode 0 = deactivated 1 = activated</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmFlgWntrMod</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmFlgWntrModReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Winter Mode Request by Driver</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Flag signals that the driver activated the winter mode 0 = deactivated 1 = activated</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmFlgWntrModReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmId1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission Identifier</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Information related to the access device (transmission device) used to enter the car.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmId</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr8</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmNInp1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Speed at Input</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">For Transmission with a torque converter this interface represents the turbine speed, which is the output speed of the torque converter. For Dual Clutch Transmission (DCT) this speed represents the speed of the active clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">For low speed values the speed might be a virtual speed.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmNInp</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">N1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmNrGearAct1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Actual Gear</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Shows the gear being currently engaged in the gear box.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Mapping of physical gear to representation is left open, but according to: </L-1>
				  <L-1 L="EN">(Only for manual transmission: If no information about reverse gears is available then corresponding positive values are used for reverse gears.) </L-1>
				  <L-1 L="EN">0 is drive train open (no torque at clutch is transmitted between the running engine(s) and the wheels).
The use of Continuously Variable Transmission (CVT) has to be handled by separate SW-functionalities. Also for Continuously Variable Transmission (CVT), 0 is defined as open drive train.Default value after reset is zero.</L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">Negative values: Reverse gears. </L-1>
					</P>
				  </ITEM>
				</LIST>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">Positive values: Forward gears. </L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmNrGearAct</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmNrGearConsold1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Consolidated Gear</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Shows the gear being currently engaged in the gear box.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">0 is drive train open (no torque at clutch is transmitted between the running engine(s) and the wheels).
The use of Continuously Variable Transmission (CVT) has to be handled by separate SW-functionalities. Also for Continuously Variable Transmission (CVT), 0 is defined as open drive train.Default value after reset is zero.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmNrGearConsold</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmNrGearReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Requested Gear</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Shows the gear being currently requested by the ratio strategy.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Mapping of physical gear to representation is left open, but according to: </L-1>
				  <L-1 L="EN">(Only for manual transmission: If no information about reverse gears is available then corresponding positive values are used for reverse gears.) </L-1>
				  <L-1 L="EN">The use of Continuously Variable Transmission (CVT) has to be handled by separate SW-functionalities. Also for Continuously Variable Transmission (CVT), 0 is defined as open drive train.Default value after reset is zero.</L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">Negative values: Reverse gears. </L-1>
					</P>
				  </ITEM>
				</LIST>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">Positive values: forward gears. </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">0 is drive train open (no torque at clutch is transmitted between the running engine(s) and the wheels). </L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmNrGearReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmNrGearTar1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Target Gear</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Shows the gear which will be engaged in the gear box.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">During the shifting process this value informs about the gear which is expected to be engaged in the gear box after the shifting process. Therefore it switches to the expected gear state with the beginning of the shifting process.
Mapping of physical gear to representation is left open, but according to: </L-1>
				  <L-1 L="EN">(Only for manual transmission: If no information about reverse gears is available then corresponding positive values are used for reverse gears.) </L-1>
				  <L-1 L="EN">0 is drive train open (no torque at clutch is transmitted between the running engine(s) and the wheels).
The use of Continuously Variable Transmission (CVT) has to be handled by separate SW-functionalities. Also for Continuously Variable Transmission (CVT), 0 is defined as open drive train.Default value after reset is zero.</L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">Negative values: Reverse gears. </L-1>
					</P>
				  </ITEM>
				</LIST>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">Positive values: forward gears. </L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmNrGearTar</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmNrTyp1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission Type</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Information on standard transmission.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Initialization possible by "End Of Line (EOL)" or "Key On". This information can come from compiler switch, calibration label, or as learned variant (SW identifies Gearbox type)Signal is sent with initialisation.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmNrTyp</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">TrsmTyp1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmPosn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission Position</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Information to know if the transmitters of the vehicle are inside or outside the vehicle.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmPosn</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">- Inside of the car - Outside of the car</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">InOut1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<CLIENT-SERVER-INTERFACE>
			  <SHORT-NAME>TrsmRatGear1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Gear Ratio for a Given Gear</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Returns the gear ratio for a given gear</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Theoretical transmission ratio i = ntransmission_in / ntransmission_out
transmission_in = after converter
transmission_out = gearbox out
The gear ratio means the theoretical/physical ratio belonging to each gear and not any actual measured value (proposal for Continuously Variable Transmission (CVT): if there is a wide range for gear states, this value could deliver a theoretical value).
Negative values: Reverse driving direction.
Without considering the: </L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">1.) axle ratio </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">2.) converter ratio </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">3.) High/Low-Range ratio'Default value after reset is 1.0'</L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <OPERATIONS>
				<CLIENT-SERVER-OPERATION>
				  <SHORT-NAME>GetTrsmRatGear</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Returns the Gear Ratio for a Given Gear</L-4>
				  </LONG-NAME>
				  <DESC>
					<L-2 L="EN">Returns the gear ratio for a given gear</L-2>
				  </DESC>
				  <ARGUMENTS>
					<ARGUMENT-DATA-PROTOTYPE>
					  <SHORT-NAME>Gear</SHORT-NAME>
					  <LONG-NAME>
						<L-4 L="EN">Gear for Which the Ratio Should Be Returned</L-4>
					  </LONG-NAME>
					  <DESC>
						<L-2 L="EN">Gear for which the ratio should be returned</L-2>
					  </DESC>
					  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Nr4</TYPE-TREF>
					  <DIRECTION>IN</DIRECTION>
					</ARGUMENT-DATA-PROTOTYPE>
					<ARGUMENT-DATA-PROTOTYPE>
					  <SHORT-NAME>Rat</SHORT-NAME>
					  <LONG-NAME>
						<L-4 L="EN">Gear Ratio of Given Gear</L-4>
					  </LONG-NAME>
					  <DESC>
						<L-2 L="EN">Gear ratio of given gear</L-2>
					  </DESC>
					  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac1</TYPE-TREF>
					  <DIRECTION>OUT</DIRECTION>
					</ARGUMENT-DATA-PROTOTYPE>
				  </ARGUMENTS>
				</CLIENT-SERVER-OPERATION>
			  </OPERATIONS>
			</CLIENT-SERVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatGearAct1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: The Actual Gear Ratio Being Currently Engaged in the Gear Box</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Actual theoretical transmission ratio i = ntransmission_in / ntransmission_out transmission_in = after converter transmission_out = gearbox out The gear ratio means the theoretical/physical ratio belonging to each gear and not any actual measured value (proposal for Continuously Variable Transmission (CVT): if there is a wide range for gear states, this value could deliver a theoretical value). Negative values: Reverse driving direction. Without considering the: 1.) axle ratio 2.) converter ratio 3.) High/Low-Range ratio</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Default value after reset is 1.0.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatGearAct</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatGearConsold1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: The Consolidated Gear Ratio Being Currently Engaged in the Gear Box</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Actual theoretical transmission ratio i = ntransmission_in / ntransmission_out transmission_in = after converter transmission_out = gearbox out The gear ratio means the theoretical/physical ratio belonging to each gear and not any actual measured value (proposal for Continuously Variable Transmission (CVT): if there is a wide range for gear states, this value could deliver a theoretical value). Negative values: Reverse driving direction. Without considering the: 1.) axle ratio 2.) converter ratio 3.) High/Low-Range ratio</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Default value after reset is 1.0.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatGearConsold</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatGearReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Requested Gear Ratio</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">The gear ratio which is requested by ration strategy</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Theoretical transmission ratio i = ntransmission_in / ntransmission_out transmission_in = after converter transmission_out = gearbox out The gear ratio means the theoretical/physical ratio belonging to each gear and not any actual measured value.
Proposal for Continuously Variable Transmission (CVT): if there is a wide range for gear states, this value could deliver a theoretical ratio.
Negative values: Reverse driving direction.
Without considering the: 1.) Axle ratio 2.) Converter ratio 3.) High/Low-Range ratio'Default value after reset is 1.0.'</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatGearReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatGearTar1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: The Gear Ratio Which Will Be Engaged in the Gear Box When Target Gear Is Reached</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Theoretical transmission ratio i = ntransmission_in / ntransmission_out transmission_in = after converter transmission_out = gearbox out The gear ratio means the theoretical/physical ratio belonging to each gear and not any actual measured value (proposal for Continuously Variable Transmission (CVT): if there is a wide range for gear states, this value could deliver a theoretical value). Negative values: Reverse driving direction. Without considering the: 1.) axle ratio 2.) converter ratio 3.) High/Low-Range ratio</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Default value after reset is 1.0.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatGearTar</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatTqPtAct1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Actual Powertrain Torque Ratio</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Torque conversion ratio including everything between engine and wheel, i.e. converter gain (only for hydraulic converter), gear box and axle ratio.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">TQwheel = (TQclutch * FACconverter * ntransmission_in / nwheel) - TQlossDT
TQ conversion ratio = FACconverter * ntransmission_in / nwheel (remark: TQlossDT is not considered here)
FACconverter = converter gain
transmission_in = after converter/clutch
Inertia is not considered.
The torque conversion ratio considers only the total powertrain torque at wheels, not the wheel individual torque distribution.
At open drivetrain: </L-1>
				  <L-1 L="EN">To get a valid value during the open drivetrain always the lowest gear should be used except: </L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">Driver or strategy selects "N" or "P": Every transmission has an open drivetrain </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">Low vehicle speed: Manual Transmission (MT), Automatic Manual Transmission (AMT) and Dual Clutch Transmission (DCT) have an open drivetrain. For Automatic Transmission (AT) and Continuously Variable Transmission (CVT) the drivetrain is still closed (hydraulic converter) </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">Shifting: Only Manual Transmission (MT) and Automatic Manual Transmission (AMT) have an open drivetrain </L-1>
					</P>
				  </ITEM>
				</LIST>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">for Automatic Manual Transmission (AMT), if a gear shift is detected, the torque ratio calculation changes from using the current gear state to the target gear state at some point during the shift. This point of change must be agreed between transmitter and receiver. The torque ratio never indicates neutral during a shift. </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">for Automatic Transmission (AT), Continuously Variable Transmission (CVT) and Dual Clutch Transmission (DCT): While the drivetrain is open the transmission prepares a theoretical gear position to engage immediately after the driver selects "D". This theoretical gear state information should be used.Default value after reset is 1.0.</L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatTqPtAct</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatTqPtConsold1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Consolidated Powertrain Torque Ratio</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Torque conversion ratio including everything between engine and wheel, i.e. converter gain (only for hydraulic converter), gear box and axle ratio.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">TQwheel = (TQclutch * FACconverter * ntransmission_in / nwheel) - TQlossDT
TQ conversion ratio = FACconverter * ntransmission_in / nwheel
(remark: TQlossDT is not considered here)
FACconverter = converter gain
transmission_in = after converter/clutch
Inertia is not considered.
The torque conversion ratio considers only the total powertrain torque at wheels, not the wheel individual torque distribution.
At open drivetrain: </L-1>
				  <L-1 L="EN">To get a valid value during the open drivetrain always the lowest gear should be used except: </L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">Driver or strategy selects "N" or "P": every transmission has an open drivetrain </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">Low vehicle speed: Manual Transmission (MT), Automatic Manual Transmission (AMT) and Dual Clutch Transmission (DCT) have an open drivetrain. For Automatic Transmission (AT) and Continuously Variable Transmission (CVT) the drivetrain is still closed (hydraulic converter) </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">Shifting: Only Manual Transmission (MT) and Automatic Manual Transmission (AMT) have an open drivetrain </L-1>
					</P>
				  </ITEM>
				</LIST>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">for Automatic Manual Transmission (AMT), if a gear shift is detected, the torque ratio calculation changes from using the current gear state to the target gear state at some point during the shift. This point of change must be agreed between transmitter and receiver. The torque ratio never indicates neutral during a shift. </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">for Automatic Transmission (AT), Continuously Variable Transmission (CVT) and Dual Clutch Transmission (DCT): While the drivetrain is open the transmission prepares a theoretical gear position to engage immediately after the driver selects "D". This theoretical gear state information should be used.Default value after reset is 1.0.</L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatTqPtConsold</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatTqTrsmOutpByTqClu1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Ratio of Torque at Transmission Output by Torque at Clutch</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Ratio of torque at transmission output by torque at clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Current ratio of “Torque at Transmission Output” by “Torque at Clutch”.
This ratio covers the ratio of the gearbox, but does not cover the ratio of the transfer case or the ratio of the reduction gearbox, if present.</L-1>
				  <L-1 L="EN">For transmissions without a converter:
The slip of the drive-off element is supposed to be zero for the calculation of this signal.</L-1>
				  <L-1 L="EN">For transmissions with a converter:
The signal is calculated with the current converter torque ratio. The converter torque ratio is continuously updated.
For transmissions with a converter, the signal is the combination of the current torque ratio of the gearbox core and the actual torque ratio of the converter including the converter clutch, if present.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatTqTrsmOutpByTqClu</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Transmission: Ratio of Torque at Transmission Output by Torque at Clutch</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatTqTrsmOutpByTqCluTar1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Target Ratio of Torque at Transmission Output By Torque at Clutch</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Target ratio of torque at transmission output by torque at clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">The ratio of "Torque at Transmission Output" by "Torque at Clutch", calculated at the current vehicle speed, is expected to be reached when the target gear is engaged.</L-1>
				  <L-1 L="EN">This ratio covers the ratio of the gearbox, but not the transfer case and the reduction gearbox, if present.</L-1>
				  <L-1 L="EN">For transmissions without a converter:
The slip of the drive-off element is supposed to be zero for the calculation of this signal.</L-1>
				  <L-1 L="EN">For transmissions with a converter:
The signal is calculated with the current converter torque ratio, because the converter torque ratio in the target gear is unknown. The converter torque ratio is continuously updated.
For transmissions with a converter, the signal is the combination of the torque ratio of the gearbox core in target gear and the current torque ratio of the converter including the converter clutch, if present.</L-1>
				  <L-1 L="EN">The signal changes synchronously with the change of the "Transmission: Transmission Gear State".</L-1>
				  <L-1 L="EN">References to other signals:
TrsmGearSt</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatTqTrsmOutpByTqCluTar</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Transmission: Target Ratio of Torque at Transmission Output By Torque at Clutch</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatTqWhlByTqClu1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Ratio of Torque at Wheel by Torque at Clutch</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Ratio of torque at wheel by torque at clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Current ratio of "Torque at Wheel" by "Torque at Clutch".
This ratio covers the ratio of the gearbox, the transfer case and the reduction gearbox, if present.</L-1>
				  <L-1 L="EN">For transmissions without a converter:
The slip of the drive-off element is supposed to be zero for the calculation of this signal.</L-1>
				  <L-1 L="EN">For transmissions with a converter:
The signal is calculated with the current converter torque ratio. The converter torque ratio is continuously updated.
For transmissions with a converter, the signal is the combination of the current torque ratio of the gearbox core and the current torque ratio of the converter including the converter clutch, if present.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatTqWhlByTqClu</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Transmission: Ratio of Torque at Wheel by Torque at Clutch</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRatTqWhlByTqCluTar1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Target Ratio of Torque at Wheel by Torque at Clutch</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Target ratio of torque at wheel by torque at clutch.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">The ratio of "Torque at Wheel" by "Torque at Clutch", calculated at the current vehicle speed, is expected to be reached when the target gear is engaged.</L-1>
				  <L-1 L="EN">This ratio covers the ratio of the gearbox, the transfer case and the reduction gearbox, if present.</L-1>
				  <L-1 L="EN">For transmissions without a converter:
The slip of the drive-off element is supposed to be zero for the calculation of this signal.</L-1>
				  <L-1 L="EN">For transmissions with a converter:
The signal is calculated with the current converter torque ratio, because the converter torque ratio in the target gear is unknown. The converter torque ratio is continuously updated.
For transmissions with a converter, the signal is the combination of the torque ratio of the gearbox core in target gear and the current torque ratio of the converter including the converter clutch, if present.</L-1>
				  <L-1 L="EN">The signal changes synchronously with the change of the "Transmission: Transmission Gear State".</L-1>
				  <L-1 L="EN">References to other signals:
TrsmGearSt</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRatTqWhlByTqCluTar</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Transmission: Target Ratio of Torque at Wheel by Torque at Clutch</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Fac5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmRxnOfPasePanicReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission Reception of Pase Panic Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request given by Passive Entry (PASE) to command a panic alert.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmRxnOfPasePanicReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">ReqSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmStGearLvr1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Gear Lever Position</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">The signal is based on the lever position. Only defined for automatic transmissions.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmStGearLvr</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">TrsmPosnGearLvr1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmStTrfCaseDftl1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Status of the Transfer Case Differential</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status of the Transfer Case Differential</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmStTrfCaseDftl</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevErrSt4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>

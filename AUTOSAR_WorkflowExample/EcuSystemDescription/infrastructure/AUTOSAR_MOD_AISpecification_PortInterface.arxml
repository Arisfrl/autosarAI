			  <SHORT-NAME>LiOnWarnReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Light On Warning Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request for acoustic signaling of "forgotten" lights turned on status.</L-2>
			  </DESC>

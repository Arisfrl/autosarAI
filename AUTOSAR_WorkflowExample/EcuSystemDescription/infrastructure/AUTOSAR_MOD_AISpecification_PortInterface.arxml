			  <LONG-NAME>
				<L-4 L="EN">Lock Unlock Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">User request for emergency locking in case of danger.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">LockUnlckReq1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>

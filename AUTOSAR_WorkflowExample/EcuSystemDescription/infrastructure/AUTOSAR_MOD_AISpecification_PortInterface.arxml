			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PrkgBrkAppldIndcn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Parking Brake Applied Indication</L-4>
			  </LONG-NAME>
			  <DESC>

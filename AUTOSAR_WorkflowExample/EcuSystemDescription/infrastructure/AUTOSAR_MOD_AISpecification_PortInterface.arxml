			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ProfPenSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Driver Profile</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status of current selected personalization profile from profile manager. It is a common profile selectable from transponder, remote key, keyless access, Human Machine Interface (HMI)...</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Id</SHORT-NAME>

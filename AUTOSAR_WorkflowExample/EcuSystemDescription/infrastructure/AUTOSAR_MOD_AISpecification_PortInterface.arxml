			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">measured or model based ambient air pressure</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">signal is sent with initialisation</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>EngPAmbAir</SHORT-NAME>

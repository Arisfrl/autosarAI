			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PwrSplySt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Power Supply Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Current power supply status</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>

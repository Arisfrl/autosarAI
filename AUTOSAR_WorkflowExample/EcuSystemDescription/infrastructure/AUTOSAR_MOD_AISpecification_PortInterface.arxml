				<L-4 L="EN">Total Powertrain Torque at Wheels</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Generic interface for total powertrain torque at wheels</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>

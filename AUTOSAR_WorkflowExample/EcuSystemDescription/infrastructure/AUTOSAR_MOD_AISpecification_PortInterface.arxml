				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>LockCmd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Lock Command</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This is the functional command to the actuator component to execute the command unlock, lock or safe (double lock) at the latch.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Cmd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">LockActvn1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>LockSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Lock Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status of the latch. This interface provides the information about the current locking state of the latch. It does not distinguish between the source through which it was operated (mechanical key, the internal motor or the internal knob). This Status is provided to the central locking in order to unlock/lock/save the other latches of the vehicle.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">LockSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>LockStOfSteerCol1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Steering Column Lock Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Indication about the locking status of the steering column</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>LockStOfSteerCol</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">LockStOfSteerCol1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>LockSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Lock Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status of the latch. This interface provides the information about the current locking state of the latch. It does not distinguish between the source through which it was operated (mechanical key, the internal motor or the internal knob). This Status is provided to the central locking in order to unlock/lock/save the other latches of the vehicle.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Sts</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">LockSts1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>LockStsOfSteerCol1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Steering Column Lock Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Indication about the locking status of the steering column</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>

			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>EngN1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Engine Speed</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">The consolidated rotational speed of the engine crankshaft.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">E.g. evaluated from a segment synchronous source.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>EngN</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">N1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>EngNGearTar1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Engine Speed at Target Gear</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Used for Dual Clutch Transmission (DCT) to provide the transmission with a predicted engine torque. The transmission precalculates this speed.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>

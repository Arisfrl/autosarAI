			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>TrsmTOil1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Transmission: Transmission Oil Temperature</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Transmission oil temperature.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">No further explanation needed.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>TrsmTOil</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Transmission: Transmission Oil Temperature</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">T4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>

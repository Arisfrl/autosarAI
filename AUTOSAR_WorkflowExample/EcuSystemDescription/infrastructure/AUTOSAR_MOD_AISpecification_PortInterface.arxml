				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgAltDeactvtReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Request to Deactivate Alternator (Generator)</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request to deactivate Alternator (generator) 0 = no deactivation of Alternator requested 1 = deactivation of Alternator requested.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgAltDeactvtReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgDrvOvrdVlc1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Driver Request Overrides Vehicle Longitudinal Control (VLC)</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Flag is set to 1 if driver request overrides Vehicle Longitudinal Control (VLC), otherwise the flag is set to 0</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgDrvOvrdVlc</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgEngRun1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Engine Is Running</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Powertrain: Cranking finished and engine is running 0 = engine not running 1 = engine running</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgEngRun</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgEngStop1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Engine Is Stopped</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Powertrain: Engine is stopped 0 = engine not stopped 1 = engine stopped</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgEngStop</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgEngStopReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Engine Stop Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Powertrain: Engine stop request 0 = no request to stop engine 1 = request to stop engine</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgEngStopReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgEngStopReqAllwd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Request to Stop Engine Is Allowed</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Powertrain: Request to stop engine is allowed 0 = request to stop engine not allowed 1 = request to stop engine allowed</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgEngStopReqAllwd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgEngStrtReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Engine Start Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Powertrain: Engine start request 0 = no request to start engine 1 = request to start engine</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgEngStrtReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgEngStrtReqAllwd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Request to Start Engine Is Allowed</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Powertrain: Request to start engine is allowed 0 = request to start engine not allowed 1 = request to start engine allowed</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgEngStrtReqAllwd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgHvacDeactvt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Request to Deactivate Air Conditioner (A/C)</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request to deactivate Air Conditioner (A/C) 0 = no deactivation of A/C requested 1 = deactivation of A/C requested</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgHvacDeactvt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgNoTqWhlReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: No Torque Request for Wheel Torque</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Wheel torque request below or equal a certain threshold. Torque demands considered : Driver (accelerator pedal), Cruise Control, Adaptive Cruise Control, Variable Vehicle Speed Limitation, Torque increase by Electronic Stability Control (ESC) [engine drag torque control (MSR)]</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">0: Torque request above threshold 1: Torque request below or equal threshold
e.g. threshold could be given by loss torques or a calibration value</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgNoTqWhlReq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgTqDecPsbl1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Torque Decrease Possible</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">A decrease of powertrain torque is possible (especially for Electronic Stability Control (ESC)).</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">If the limit of torque realization is reached during an intervention, the bit will change to false. 0 = decrease of powertrain torque is not possible 1 = decrease of powertrain torque is possible</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgTqDecPsbl</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">A decrease of powertrain torque is possible (especially for Electronic Stability Control (ESC)).</L-2>
				  </DESC>
				  <INTRODUCTION>
					<P>
					  <L-1 L="EN">If the limit of torque realization is reached during an intervention, the bit will change to false. 0 = decrease of powertrain torque is not possible 1 = decrease of powertrain torque is possible</L-1>
					</P>
				  </INTRODUCTION>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtFlgTqIncPsbl1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Torque Increase Possible</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">An increase of powertrain torque is possible (especially for Electronic Stability Control (ESC)).</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">If the limit of torque realization is reached during an intervention, the bit will change to false. 0 = increase of powertrain torque is not possible 1 = increase of powertrain torque is possible</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFlgTqIncPsbl</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">An increase of powertrain torque is possible (especially for Electronic Stability Control (ESC)).</L-2>
				  </DESC>
				  <INTRODUCTION>
					<P>
					  <L-1 L="EN">If the limit of torque realization is reached during an intervention, the bit will change to false. 0 = increase of powertrain torque is not possible 1 = increase of powertrain torque is possible</L-1>
					</P>
				  </INTRODUCTION>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME NAME-PATTERN="{anyName}">PtFuCutCoastActv1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Fuel Cut-Off in Coast Active</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Fuel cut-off in coast is active.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Fuel cut-off is active for all cylinders of the combustion engine.
Typically used for activating adaptation functions in the transmission controller.</L-1>
				  <L-1 L="EN">At initialization, "fuel cut-off inactive" is sent.</L-1>
				  <L-1 L="EN">0 = Fuel cut-off is inactive
1 = Fuel cut-off is active</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtFuCutCoastActv</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Fuel Cut-Off in Coast Active</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtGearLvrLockReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Gear Lever Lock Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Locking the gear lever is requested by powertrain.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Locking the gear lever is requested by the powertrain. Typically used to lock the gear lever in the parking position until the driver presses the brake to prevent an unintended vehicle acceleration.
The signal is also named "Shift Lock Request".</L-1>
				  <L-1 L="EN">0 = not requested
1 = requested</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtGearLvrLockReq</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Gear Lever Lock Request</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">ReqSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtKdDetd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Kickdown Detected</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Accelerator pedal is in a kickdown position.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">The kickdown switch is pressed or the accelerator pedal position is greater than a threshold.</L-1>
				  <L-1 L="EN">0 = no kickdown (Flag reset)
1 = kickdown (Flag set)</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtKdDetd</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Kickdown Detected</L-4>
				  </LONG-NAME>
				  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/AUTOSAR_AISpecification/ApplicationDataTypes/Flg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtNClu1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Speed at Clutch from Powertrain</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This interface is used only for vehicles, where the engine speed can be different from the speed at converter or clutch. This signal is a combination of the engine speed and the speed of the electric machine, at the engine/electric machine side of the transmission clutch or converter.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Definition of "Clutch": </L-1>
				  <L-1 L="EN">Signal is sent with initialisation.</L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">for Automatic Transmission (AT), Continuously Variable Transmission (CVT) it is the converter clutch </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">for Manual Transmission (MT), Automatic Manual Transmission (AMT) it is the clutch between the gear box and the engine drivetrain. </L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtNClu</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">N1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtNEngSp1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Engine Speed Setpoint</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">calculated engine speed setpoint e.g. idle engine speed setpoint during idle</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Default value after reset: zero</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtNEngSp</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">N1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtRatTqDistbnReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Requested Percental Distribution of Torque to Wheels</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This interface only considers the torque which can be distributed from one or more central torque producers to the wheels by the transmission system. It does not consider additional torque producers located e.g. at the individual wheels. Where no torque is distributed to the wheels by the transmission system (e.g. one axle not driven or directly driven by an electric machine), the respective values are zero. The sum of all 4 values must be 100%.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtRatTqDistbnReqFrntLe</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Front left wheel</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtRatTqDistbnReqFrntRi</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Front right wheel</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtRatTqDistbnReqReLe</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Rear left wheel</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtRatTqDistbnReqReRi</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Rear right wheel</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqClu1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Torque at Clutch</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Indicated torque of combustion engine plus torque of electric machine, if present, plus internal engine torque losses plus all losses with an effect on the torque at clutch. The effect of inertia on the torque is not considered.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Torque at clutch is a torque at the mechanical interface between engine and transmission. For manual transmissions, the mechanical interface is the primary side of the clutch, for automatic transmissions, this is the primary side of the converter.</L-1>
				  <L-1 L="EN">Torque at clutch considers the following contributors, if present:
1) Indicated torque of combustion engine, calculated on basis of injection timing and injected fuel, ignition angle and air mass.
2) Torque of electric machine at clutch level.
3) Internal engine torque losses such as friction, pumping, mechanically driven water pump, etc.
4) Ancillary torque losses with an effect on the torque at clutch caused by the alternator, air conditioning, power steering, etc.</L-1>
				  <L-1 L="EN">The calculation of this signal by the provider is not permitted to consider the inertia, which has an effect on the torque at clutch. This means that the signal must be calculated as if the inertia is 0 kg*(m^2).
Loss differences from engine to engine and variable torque losses over the life cycle must be considered.
In parallel hybrid projects, the combustion engine torque must be considered depending on the engine clutch state.
If there is a mechanically driven transmission oil pump, then the oil pump is a consumer of the transmission, not a consumer of the engine. So the oil pump drive torque is not permitted to be subtracted by the provider of this signal.</L-1>
				  <L-1 L="EN">The signal can be calculated based on “Engine: Torque at Crankshaft”, so this signal includes all torque requests from accelerator pedal, cruise control, speed limiter, etc. and all interventions such as torque and speed interventions.
Hint for implementation:
The torque is a cylinder average, not a time average, via two crankshaft revolutions of all cylinders, in consideration of the current operating parameters. The operating parameters include engine temperature, ignition timing and air mass measured or calculated, lambda, fuel cut level, fuel quantity, injection timing, knock control adaption, geographic altitude and others.</L-1>
				  <L-1 L="EN">References to other signals:
EngTqCrksft</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqClu</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Torque at Clutch</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCluDyn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Dynamic Torque at Clutch</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This interface has to consider all engine internal and auxiliary inertia torques, but no transmission inertia torques.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Example of usage: Used for Transmission to calculate a predictive slipping time of the clutch to prepare an ideal termination of shifting.
Note the definition of "dynamic torque correction": This signal has to consider all internal inertia torques of specific components.
Dynamic Torque at Clutch = Torque At Clutch + Engine dynamic moment of inertia. Default value after reset is zero.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluDyn</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCluEngMaxProtnReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Torque at Engine Clutch Requested by Powertrain Coordinator for Engine Clutch Protection</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Maximum torque for engine clutch protection, independent of direction/ sign of the torque.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">The maximum torque is independent of the sign of the torque, i.e. of the direction of the torque flow.
The actual torque at engine clutch depends on the combustion engine torque, the electric machine torque, the transmission input torque and on the torque of inertia.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluEngMaxProtnReq</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Maximum Torque at Engine Clutch Requested by Powertrain Coordinator for Engine Clutch Protection</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME NAME-PATTERN="{anyName}">PtTqCluMaxCluNCurLongTerm1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Torque at Clutch at Current Clutch Speed Long Term Attainable</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Maximum possible torque at clutch at current clutch speed which is long term attainable.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">For non-hybrid projects this signal reflects the full load engine torque at clutch at current engine speed which the engine could implement within a long time period, especially when maximally charged.
It is calculated at current ambient pressure and air temperature and includes the static power limitation of the engine.</L-1>
				  <L-1 L="EN">In parallel hybrid projects, the signal is the sum of the maximum torque of combustion engine and electric machine, considering the engine clutch state.</L-1>
				  <L-1 L="EN">The static power limitation contains, e.g., restrictions for protection and static soot limitation.
Permanent knock limitation is considered, knock control is not considered.</L-1>
				  <L-1 L="EN">The calculation of this signal by the provider is not permitted to consider the inertia, which has an effect on the torque at clutch. This means that the signal must be calculated as if the inertia is 0 kg*(m^2).</L-1>
				  <L-1 L="EN">Example for accuracy requirements in a typical series project: ±5 %.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluMaxCluNCurLongTerm</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Maximum Torque at Clutch at Current Clutch Speed Long Term Attainable</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME NAME-PATTERN="{anyName}">PtTqCluMaxCluNCurShoTerm1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Torque at Clutch at Current Clutch Speed Short Term Attainable</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Maximum possible torque at clutch at current clutch speed which is short term attainable.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">For non-hybrid projects this signal reflects the full load engine torque at clutch at current engine speed, which the engine could implement within a short time period, for example, 200 ms. This period must be defined in close cooperation between engine experts and transmission experts.
It is calculated at current ambient pressure and air temperature and includes the static power limitation of the engine.
In parallel hybrid projects, the signal is the sum of the maximum torque of combustion engine and electric machine, considering the engine clutch state.
The static power limitation contains, e.g., restrictions for protection and static soot limitation.
Permanent knock limitation is considered, knock control is not considered.</L-1>
				  <L-1 L="EN">The calculation of this signal by the provider is not permitted to consider the inertia, which has an effect on the torque at clutch. This means that the signal must be calculated as if the inertia is 0 kg*(m^2).</L-1>
				  <L-1 L="EN">Example for accuracy requirements in a typical series project: ±5 %.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluMaxCluNCurShoTerm</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Maximum Torque at Clutch at Current Clutch Speed Short Term Attainable</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCluMaxDrv1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Available Torque at Clutch for Driver</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Maximum possible torque at clutch at optimum conditions delivered by powertrain for driver.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Example of realization: Could take into account: current engine speed, ambient pressure, air temperature, static power limitation due to engine, auxiliaries (everything with impact to the torque output, e.g. power steering pump, Air Conditioner (A/C), generator or starter generator), smoke limitation, fuel quality correction. Including maximum overboost.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluMaxDrv</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME NAME-PATTERN="{anyName}">PtTqCluMinByIgnRtd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Minimum Torque at Clutch By Ignition Retard</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Minimum torque at clutch, which the powertrain can provide in the short term, e.g. on engine side by the minimum permitted ignition angle. Cylinder cut-off must NOT be considered.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">This signal is needed by the transmission to determine the intensity of the torque intervention.
The signal is necessary for the shift strategy to guarantee a comfortable operation of the powertrain system.</L-1>
				  <L-1 L="EN">The engine contribution to this signal is calculated at current engine speed with current air mass, current ambient pressure and current air temperature. </L-1>
				  <L-1 L="EN">In parallel hybrid projects, the torque coordinator must additionally consider the min. torque, which the electric machine(s) could implement at clutch in the current operating point.</L-1>
				  <L-1 L="EN">In projects with engine clutch, the current state of the engine clutch must be considered.</L-1>
				  <L-1 L="EN">The calculation of this signal by the provider is not permitted to consider the inertia, which has an effect on the torque at clutch. This means that the signal must be calculated as if the inertia is 0 kg*(m^2).</L-1>
				  <L-1 L="EN">Example for accuracy requirements in a typical series project: ±7 % or ±5 Nm (max. selection), max. deviation ±20 Nm.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluMinByIgnRtd</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Minimum Torque at Clutch By Ignition Retard</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCluMinDrv1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Minimum Available Torque at Clutch for Driver</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Minimum possible torque at clutch delivered by powertrain for driver.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Example of realization: Could take into account: Losses of auxiliaries, integral part of idle speed controller, indicated torque, engine friction, fuel cut off.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluMinDrv</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME NAME-PATTERN="{anyName}">PtTqCluMinFast1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Minimum Torque at Clutch Fast Path</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Minimum torque at clutch, which the powertrain can provide in the short term, e.g. on engine side by the minimum permitted ignition angle and cylinder cut-off.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">This signal is needed by the transmission to determine the intensity of the torque intervention.</L-1>
				  <L-1 L="EN">The engine contribution to this signal is calculated at current engine speed with current air mass, current ambient pressure and current air temperature.</L-1>
				  <L-1 L="EN">In parallel hybrid projects, the torque coordinator must additionally consider the min. torque, which the electric machine(s) could implement at clutch in the current operating point.</L-1>
				  <L-1 L="EN">In projects with engine clutch, the current state of the engine clutch must be considered.</L-1>
				  <L-1 L="EN">The calculation of this signal by the provider is not permitted to consider the inertia, which has an effect on the torque at clutch. This means that the signal must be calculated as if the inertia is 0 kg*(m^2).</L-1>
				  <L-1 L="EN">Example for accuracy requirements in a typical series project: ±7 % or ±5 Nm (max. selection), max. deviation ±20 Nm.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluMinFast</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Minimum Torque at Clutch Fast Path</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCluReqWoTrsmIntv1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Requested Torque at Clutch without Transmission Intervention</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Driver torque request including all interventions except transmission shift interventions and including all limitations.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Limitations include environmental conditions such as altitude, temperature, etc. and engine limitations such as soot limitation, full load limit, etc.</L-1>
				  <L-1 L="EN">The goal is that the torque information is sent 50 – 80 ms ahead of the desired real/physical torque.</L-1>
				  <L-1 L="EN">For further explanation see signal "Powertrain: Driver Request of Torque at Clutch".</L-1>
				  <L-1 L="EN">In parallel hybrid projects, the signal is the sum of the torque request to the electric machine and that part of the torque request to the combustion engine, which is transferred by the engine clutch. The sum does not consider the transmission intervention.</L-1>
				  <L-1 L="EN">References to other signals:
PtDrvrReqTqClu</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluReqWoTrsmIntv</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Requested Torque at Clutch without Transmission Intervention</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCluTarGear1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Predicted Torque at Clutch at Target Gear</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Used for Dual Clutch Transmission (DCT) to calculate the clutch pressure to terminate the shifting comfortably. This torque is calculated with actual pedal position and an engine speed at target gear.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Default value after reset is zero.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluTarGear</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCluWoTrsmIntv1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Torque at Clutch without Transmission Intervention</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Torque at clutch that would be implemented if no transmission shift interventions are active.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Outside of a transmission intervention, the signal should show the same value as "Powertrain: Torque at Clutch”.</L-1>
				  <L-1 L="EN">Highly dynamic torque contributions by anti jerk are not visible, in contrary to signal “Powertrain: Torque at Clutch”.</L-1>
				  <L-1 L="EN">During interventions, the signal should show the desired torque without considering the intervention, independent of implementation by ignition, air, cylinder cutoff.
The effects of the transmission request for shifts on the air path or cylinder cutoff are NOT considered, not even if the fast path request can only be implemented by affecting the air path or cylinder cutoff.</L-1>
				  <L-1 L="EN">The calculation of this signal by the provider is not permitted to consider the inertia, which has an effect on the torque at clutch. This means that the signal must be calculated as if the inertia is 0 kg*(m^2).</L-1>
				  <L-1 L="EN">References to other signals:
PtTqClu</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCluWoTrsmIntv</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Torque at Clutch without Transmission Intervention</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCrksftRedByAncllryLossReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Requested Torque at Crankshaft Reduced by Ancillary Losses</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Requested torque at crankshaft reduced by ancillary losses, including all interventions, including all limitations.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">The signal contains the limitations which are closely related to the combustion engine or which are attributed to the combustion engine by the powertrain coordinator.</L-1>
				  <L-1 L="EN">The calculation of this signal by the provider is not permitted to consider the inertia, which has an effect on the torque at clutch. This means that the signal must be calculated as if the inertia is 0 kg*(m^2).</L-1>
				  <L-1 L="EN">The signal contains all interventions.</L-1>
				  <L-1 L="EN">The goal is that the torque information is sent 50 – 80 ms ahead of the desired real/physical torque.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCrksftRedByAncllryLossReq</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Requested Torque at Crankshaft Reduced by Ancillary Losses</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCrksftReqFast1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Crankshaft Torque Request to Be Realized by the Fast Path of Powertrain</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Required crankshaft torque which should be generated by engine. The engine will restrict this request to its internal limits.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Example of realization: Including fast torque intervention from brake control, transmission control etc.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCrksftReqFast</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqCrksftReqSlow1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Crankshaft Torque Request to Be Realized by the Slow Path of Powertrain</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Crankshaft torque which should be realized by the slow path to prepare the engine for a future torque setpoint. The engine will restrict this request to its internal limits.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Example of realization: If there is no distinction between slow and fast path control within the engine management (e.g. for a Diesel engine), this signal can be ignored by the engine management. Without fast torque intervention from brake control, transmission control etc.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqCrksftReqSlow</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqJClu1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Torque of Inertia at Clutch</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Dynamic moment of inertia of all components of the drive unit on clutch level. Definition of the sign: An increasing speed produces a negative sign; a decreasing speed produces a positive sign.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">The signal contains the dynamic torque caused by the inertia which increases or decreases the torque at clutch.</L-1>
				  <L-1 L="EN">The engine internal inertia and the inertia of the ancillaries up to the clutch must be considered.</L-1>
				  <L-1 L="EN">In parallel hybrid projects, the inertia of combustion engine and electric machine are considered. Additionally, the inertia of engine clutch must be considered.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqJClu</SHORT-NAME>
				  <LONG-NAME>
					<L-4 L="EN">Powertrain: Torque of Inertia at Clutch</L-4>
				  </LONG-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqMaxAc1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Allowed Torque for A/C Compressor</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Allowable torque for Air Condition (A/C) compressor. It is an engine crankshaft torque.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Examples of realization: This interface could contain either </L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">the torque that the Air Conditioning (A/C) compressor is allowed to consume in steady state </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">the highest torque that the Air Condition (A/C) compressor is allowed to consume at any point in time</L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqMaxAlt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Allowed Alternator Load</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Allowed mechanical load for alternator (generator) at engine crankshaft.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqMaxAlt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq6</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqMaxHvac1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Allowed Torque for A/C Compressor</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Allowable torque for Air Condition (A/C) compressor. It is an engine crankshaft torque.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Examples of realization: This interface could contain either </L-1>
				</P>
				<LIST TYPE="UNNUMBER">
				  <ITEM>
					<P>
					  <L-1 L="EN">the torque that the Air Conditioning (A/C) compressor is allowed to consume in steady state </L-1>
					</P>
				  </ITEM>
				  <ITEM>
					<P>
					  <L-1 L="EN">the highest torque that the Air Condition (A/C) compressor is allowed to consume at any point in time</L-1>
					</P>
				  </ITEM>
				</LIST>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqMaxHvac</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq6</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqMaxSteer1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Allowed Mechanical Load for Steering at Engine Crankshaft</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Allowed mechanical load for steering at engine crankshaft.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">In case of electric steering, this should be zero Nm, because the load is included in alternator load.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqMaxSteer</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq6</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqMaxTrsmOilPmp1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Powertrain: Maximum Allowed Transmission Oil Pump Load</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Maximum allowed transmission oil pump load at engine crank shaft.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">If the oil pump is driven by the engine crank shaft then this value must take into account all relevant dynamic effects. If it is an electric oil pump, the value should be zero Nm, because the load is included in alternator load. The value of this signal is converted to engine crank shaft torque by the provider.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqMaxTrsmOilPmp</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq6</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqResvEng1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Torque Reserve Request from Powertrain to Engine</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Reserved torque request coordinated in the Powertrain coordinator (PTC) to be realized by the combustion engine. The coordination can consider multiple reserved torque requirements, e.g. auxiliary loads such as Air Conditioning (A/C) compressor.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Default value after reset is zero.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqResvEng</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>PtTqResvReqEng1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Torque Reserve Request from Powertrain to Engine</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Reserved torque request coordinated in the Powertrain coordinator (PTC) to be realized by the combustion engine. The coordination can consider multiple reserved torque requirements, e.g. auxiliary loads such as Air Conditioning (A/C) compressor.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Default value after reset is zero.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PtTqResvReqEng</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq5</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>

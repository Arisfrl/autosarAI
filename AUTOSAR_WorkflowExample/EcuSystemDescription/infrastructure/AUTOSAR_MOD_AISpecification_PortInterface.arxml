				  <SHORT-NAME>VehHldSts</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">VehHldSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehM1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Vehicle Mass</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Vehicle mass provided</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehM</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">M1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehMEstimd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Vehicle Mass Estimated</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Estimation of the vehicle mass provided</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehMEstimd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">M1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehMod1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Vehicle Mode</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This information is needed to know if the vehicle is in factory mode, show room mode, customer mode</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehMod</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">VehMod1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehMtnSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Vehicle Motion State 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Vehicle motion state whether vehicle is moving forward or backward or if it is in stand still.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehMtnSt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">VehMtnSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehPitchovrMod1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Vehicle Pitchover Mode</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This interface shows the state of pitchover</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehPitchovrMod</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">PitchovrMod1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehRollovrMod1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Vehicle Rollover Mode</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">This interface shows the state of rollover</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehRollovrMod</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">RollovrMod1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehSpd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Vehicle Speed 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Generic interface for vehicle speed</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehSpd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Spd3</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehSpdDispd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Displayed Vehicle Speed</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Vehicle speed shown on speedometer.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehSpdDispd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Spd4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehSpdLgt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Vehicle Speed Longitudinal 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Vehicle longitudinal speed based on individual wheel speeds, possibly extended by acceleration sensor. Coordinate system according to ISO 8855. The vehicle speed refers to Center Of Gravity (COG).</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">During brake intervention the accuracy of vehicle speed may be reduced, e.g. For the measured value only 2 wheel speed sensors are used as the other ones are locked.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehSpdLgt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Spd1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>VehTqWhlMaxSftyLimn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Safety Torque Limit Calculated from the Vehicle's Maximum Speed</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Torque limit calculated from the vehicle's maximum speed limit. This speed limit is not the "comfort" speed limit; it is the safety or vehicle protection limit, normally not selectable by the driver.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>VehTqWhlMaxSftyLimn</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq7</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WhlBrkOvrheatd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wheel Brake Overheated 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Wheel brake overheating Indication that at least one wheel brake (caliper, disc, pad) temperature is high</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>WhlBrkOvrheatd</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: normal brake temperature 1: brake overheated</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">TSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WhlLoadDif1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wheel Load Difference 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Generic interface for wheel load difference on an axle defined as the total axle load applied to the left wheel (100%: Total axle load on left wheel, 0%: Total axle load on right wheel)</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>WhlLoadDif</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WhlSpdWarnIndcn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wheel Speed Warning Indication 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Warning indication, that the maximum speed allowed for the configured tires and/or actual pressure has been exceeded.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>WhlSpdWarnIndcn</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">TirePMonWarnSt3</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WinHeatrSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Window Heater Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Activation status of window heater</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>WinHeatrSt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevSt4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WinHeatrSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Window Heater Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Activation status of window heater</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>WinHeatrSts</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevSts4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WinWipgCmd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Window Wiping Command</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Provides information to activate the front wiper. As long as the information is provided the actuator should be on.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Cmd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Wipg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WipgReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wiping Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">User request for wiping to switch on one strike, interval, low speed or high speed wiping. As long as a wipe sequence is requested, the corresponding value in the table below should be set.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Req</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">UsrReqForWipg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WipgSpdIntlReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wiping Speed Interval Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Requests the interval speed. As long as a interval wipe sequence is requested the provided value of interval speed has to be used.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Req</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">WipgSpdIntl1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WiprPosnCmd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wiper Position Command</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Provides information to run in a predefined position. As long as the information is provided the actuator should run/ stay in this position. If there is a valid Window Wiper Command, this supersedes commands given via this interface.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>PosnReqd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">WiprPosnReqd1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WiprSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wiper Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Wiper status information</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Actv</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Provides information whether the wiper is currently running. (This is different to the status data element, as the status may report an active interval wiping. Consequently, the status data element does not allow to determine, if the wiper is currently running.) As long as the status is valid the corresponding value should be provided.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Failr</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Used as feedback from an actuator component to indicate that the wiper is broken.</L-2>
				  </DESC>
				  <INTRODUCTION>
					<P>
					  <L-1 L="EN">Note that no details of the fault are transmitted, but just an operational / defective fault indication.This data element shall not be used for detailed diagnostics.</L-1>
					</P>
				  </INTRODUCTION>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevErrSt2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Posn</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Provides information in which position the wiper is in. As long as the status is valid the corresponding value should be provided.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">WiprPosnMeasd1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Provides information about the current mode of the wiping system. As long as the status is valid the corresponding value should be provided.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Wipg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WiprSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wiper Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Wiper status information</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Actv</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Provides information whether the wiper is currently running. (This is different to the status data element, as the status may report an active interval wiping. Consequently, the status data element does not allow to determine, if the wiper is currently running.) As long as the status is valid the corresponding value should be provided.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Failr</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Used as feedback from an actuator component to indicate that the wiper is broken.</L-2>
				  </DESC>
				  <INTRODUCTION>
					<P>
					  <L-1 L="EN">Note that no details of the fault are transmitted, but just an operational / defective fault indication.This data element shall not be used for detailed diagnostics.</L-1>
					</P>
				  </INTRODUCTION>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevErrSts2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Posn</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Provides information in which position the wiper is in. As long as the status is valid the corresponding value should be provided.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">WiprPosnMeasd1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Sts</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Provides information about the current mode of the wiping system. As long as the status is valid the corresponding value should be provided.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Wipg1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WiprWshrDiReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Wiper Washer Disable Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Request to the wiper washer manager, to suppress wash or wipe actions.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Req</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WshngCmd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Washing Command</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Actual command to activate the window washing (front, rear or headlamps). As long as the information is provided the actuator should be on.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Cmd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WshngReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Washing Request</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Actual command to activate the washing, carries a user request to activate the washing of windows (front, rear or headlamps). As long as the information is provided the actuator should be on.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Req</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WshrFldSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Washer Fluid Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Provides information if the low limit of washer fluid is reached (enough=above threshold; low level=below threshold). As long as the water level is under the low limit the status is "on".</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Elm</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">WshrFldLvlLo1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WshrFldSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Washer Fluid Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Provides information if the low limit of washer fluid is reached (enough=above threshold; low level=below threshold). As long as the water level is under the low limit the status is "on".</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Elm</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">WshrFldLvlLo1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WshrSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Washer Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Provides the status and failure state information typically sent by a washer.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Failr</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Used as feedback from an actuator component to indicate that the washer is broken.</L-2>
				  </DESC>
				  <INTRODUCTION>
					<P>
					  <L-1 L="EN">Note that no details of the fault are transmitted, but just an operational / defective fault indication.</L-1>
					</P>
				  </INTRODUCTION>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevErrSt2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Provides information whether the washer is on or off. As long as the status is valid the corresponding value should be provided.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>WshrSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Washer Status</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Provides the status and failure state information typically sent by a washer.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Failr</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Used as feedback from an actuator component to indicate that the washer is broken.</L-2>
				  </DESC>
				  <INTRODUCTION>
					<P>
					  <L-1 L="EN">Note that no details of the fault are transmitted, but just an operational / defective fault indication.</L-1>
					</P>
				  </INTRODUCTION>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevErrSts2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Sts</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">Provides information whether the washer is on or off. As long as the status is valid the corresponding value should be provided.</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>YawRate1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Yaw Rate 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Generic interface for yaw rate measured along vehicle z- axis (i.e. compensated for orientation). Coordinate system according to ISO 8855</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>YawRate</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">AgSpd3</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>YawRateGrdt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Yaw Rate Gradient 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Time-derivative of Yaw Rate</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>YawRateGrdt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">AgA2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>YawStabyCtrlIntvg1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Yaw Stability Control Intervening 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Yaw stability control intervention status.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>YawStabyCtrlIntvg</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: Yaw stability control not intervening 1: Yaw stability control intervening</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">CtrlSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>YawStabyInfo1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Yaw Stability Information 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Yaw stability information: Negative shows understeer. Positive shows oversteer. 0 is designed vehicle stable state. +/-100 is start of Yaw Control intervention.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>YawStabyInfo</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc6</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>YawTq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Yaw Torque 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Generic interface for yaw torque</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>YawTq</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq2</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
		  </ELEMENTS>
		</AR-PACKAGE>
	  </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>

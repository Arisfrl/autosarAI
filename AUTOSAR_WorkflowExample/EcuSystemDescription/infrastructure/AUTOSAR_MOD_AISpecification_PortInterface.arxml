  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR_AISpecification</SHORT-NAME>
      <LONG-NAME>
        <L-4 L="EN">AUTOSAR_AISpecification</L-4>
      </LONG-NAME>
	  <AR-PACKAGES>
		<AR-PACKAGE>
		  <SHORT-NAME>PortInterfaces</SHORT-NAME>
		  <CATEGORY>STANDARD</CATEGORY>
		  <REFERENCE-BASES>
			<REFERENCE-BASE>
			  <SHORT-LABEL>ApplicationDataTypes</SHORT-LABEL>
			  <PACKAGE-REF DEST="AR-PACKAGE">/AUTOSAR_AISpecification/ApplicationDataTypes</PACKAGE-REF>
			</REFERENCE-BASE>
		  </REFERENCE-BASES>
		  <ELEMENTS>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AArbnRes1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration Arbitration Result 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Feedback from Vehicle Longitudinal Control to driver assistant systems (e.g. Adaptive Cruise Control) and other systems: information about which acceleration value is output from arbitration of Vehicle Longitudinal Control.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AArbnRes</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ACenForOccptPedSfty1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration Central for Occupant Pedestrian Safety</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">High-g acceleration, measured in center by different acceleration measurement sensors</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>A</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A8</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ACenForOccptPedSfty2</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration Central for Occupant Pedestrian Safety</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">High-g acceleration, measured in center by different acceleration measurement sensors</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>A</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A13</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AExtForOccptPedSfty1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration External for Occupant Pedestrian Safety</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">High-g acceleration, measured by different acceleration measurement satellite sensors</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>A</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A9</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AExtForOccptPedSfty2</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration External for Occupant Pedestrian Safety</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">High-g acceleration, measured by different acceleration measurement satellite sensors</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>A</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A14</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ALat1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration Lateral 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Generic interface for Lateral acceleration</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>ALat</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ALgt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration Longitudinal 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Generic interface for Longitudinal acceleration</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>ALgt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ALgt2</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration Longitudinal 2</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Control value for acceleration control. This value has to be calculated also when SW-C "Follow control and acceleration arbitration" is not in control, i.e. also in driver override situations.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AConsol</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ALoForOccptPedSfty1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration Low Range Central for Occupant Pedestrian Safety</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Low-Range-g acceleration, measured in center by different acceleration measurement sensors</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>A</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A11</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AMidForOccptPedSfty1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Acceleration Middle Range Central for Occupant Pedestrian Safety</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Mid-Range-g acceleration, measured in center by different acceleration measurement sensors</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>A</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">A12</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AbsCtrlActvForWhl1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">ABS Control Active for Wheel</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Antilock Braking System (ABS) control is active (e.g. information for Roll Stability System (RSC)).</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AbsCtrlActvForWhl</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0 = Wheel is not in Antilock Braking System (ABS) control, 1 = Wheel is in Antilock Braking System (ABS) control</L-2>
				  </DESC>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AbsCtrlIndcn1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">ABS Control Indication</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Antilock braking system (ABS) control active for other domains (e.g. for Human Machine Interface (HMI))</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AbsCtrlIndcn</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevSt4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AbsCtrlIntvg1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">ABS Control Intervening 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Antilock braking system (ABS) control is active (at least one wheel)</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AbsCtrlIntvg</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0 = No wheel has Antilock Braking System (ABS) intervening 1 = At least one wheel has Antilock Braking System (ABS) intervening</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">CtrlSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AcTq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Actual Mechanical Torque for A/C Compressor</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Actual mechanical torque for Air Conditioning (A/C) compressor</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AcTqReq1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Requested Mechanical Torque for A/C Compressor</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Requested mechanical torque for Air Conditioning (A/C) compressor. This value represents the torque consumption in a predicted future state. It is converted to engine crankshaft torque by the provider. Examples of realization: Before activation of the Air Conditioning (A/C) compressor this interface could contain either - the predicted highest torque consumption during the activation process. - the predicted torque consumption in steady state after the activation is finished.</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">Default value after reset is zero.</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AccActv1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Adaptive Cruise Control Active 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Switch operated by driver to set Adaptive Cruise Control stand-by mode on.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: off 1: on</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">OnOff1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AccCtrlActv1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Adaptive Cruise Control Control Active 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Adaptive Cruise Control is engaged and active. This information is used for display feedback for driver as well.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AccCtrlActv</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevSt4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AccVehDetd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Adaptive Cruise Control Vehicle Detected 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Target vehicle for Adaptive Cruise Control is detected. This information is used for display feedback for driver.</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>St</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">0: not detected 1: detected</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DetnSt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AccrPedlGrdt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Accelerator Pedal Gradient</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">time-derivative of the position of the accelerator pedal</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AccrPedlMeasd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Accelerator Pedal Measured Value</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Position of the accelerator pedal, not "estimated" value.&#13;
Evaluated signal jitter free without time filtering, including plausibility check, monitoring and replacement value.&#13;
0% is driver off the pedal, offsets are removed. 100% must be ensured at end point of the pedal.&#13;
Shall cover the 100% as well.&#13;
&#13;
REMARK:&#13;
signal is sent with initialisation</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AccrPedlMeasd</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AccrPedlRat1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Accelerator Pedal Ratio</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Position of the accelerator pedal, not "simulated" value for e.g. Adaptive Cruise Control (ACC) driver. Evaluated signal jitter free without time filtering, including plausibility check, monitoring and replacement value. 0% is driver off the pedal, offsets are removed. 100% must be ensured at end point of the pedal. Shall cover the 100% as well</L-2>
			  </DESC>
			  <INTRODUCTION>
				<P>
				  <L-1 L="EN">signal is sent with initialisation</L-1>
				</P>
			  </INTRODUCTION>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AccrPedlRat</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AccrPedlRatFild1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Filtered Accelerator Pedal Ratio</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">shaped / time filtered value based on accelerator pedal ratio. (e.g. PT1 with calibratable time constant) Calibration shall make it sure that the signal range is 0 - 100%. 0% is driver off the pedal, offsets are removed. 100% must be ensured at end point of the pedal. Shall cover the 100% as well;</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AccrPedlRatFild</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Perc1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>AccrPedlRatGrdt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Accelerator Pedal Ratio Gradient</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">time-derivative of the position of the accelerator pedal</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>AccrPedlRatGrdt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">PercGrdt1</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ActrBodyLvlSt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Actuator Body Level Status 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status provided by body level actuator system</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>ActrBodyLvlSt</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevSt4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ActrBodyLvlSts1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Actuator Body Level Status 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Status provided by body level actuator system</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>ActrBodyLvlSts</SHORT-NAME>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">DevSts4</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ActrTqDbnd1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Actuator Torque Deadband 1</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Generic interface for minimum and maximum increase of the requested torque (relative to the current actual value) which will lead to a change in the current torque</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Uppr</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">upper value</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq3</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>Lowr</SHORT-NAME>
				  <DESC>
					<L-2 L="EN">lower value</L-2>
				  </DESC>
				  <TYPE-TREF BASE="ApplicationDataTypes" DEST="APPLICATION-PRIMITIVE-DATA-TYPE">Tq3</TYPE-TREF>
				</VARIABLE-DATA-PROTOTYPE>
			  </DATA-ELEMENTS>
			</SENDER-RECEIVER-INTERFACE>
			<SENDER-RECEIVER-INTERFACE>
			  <SHORT-NAME>ActrYawCpbyExt1</SHORT-NAME>
			  <LONG-NAME>
				<L-4 L="EN">Actuator Yaw Capability External</L-4>
			  </LONG-NAME>
			  <DESC>
				<L-2 L="EN">Indicates yaw torque capability of the external yaw rate controller using additional actuators (steering, suspension, ...)</L-2>
			  </DESC>
			  <IS-SERVICE>false</IS-SERVICE>
			  <DATA-ELEMENTS>
				<VARIABLE-DATA-PROTOTYPE>
				  <SHORT-NAME>ActrYawCpbyExt</SHORT-NAME>
